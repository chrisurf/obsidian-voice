# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# npm is the single package manager for this project (see "packageManager" in
# package.json). package-lock.json is the one committed lockfile — a stray
# yarn.lock would resolve dependencies differently and make the released
# main.js unreproducible.
yarn.lock
pnpm-lock.yaml

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Environment files with secrets
.env.local
.env.production
.env.development
.env.test
*.env.local

# Test coverage
coverage/
*.lcov

# Jest cache
.jest/

# WebdriverIO / Obsidian e2e (downloaded Obsidian builds + CI cache-key file)
.obsidian-cache/
obsidian-versions-lock.txt

# Plugin config
data.json

.devbox/